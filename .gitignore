# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# VS Code workspace/launch configuration is developer-machine specific and
# is ignored so IDE preferences never leak into a commercial, multi-
# contributor codebase.
.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Generated code (build_runner and similar codegen output). These are
# regenerated from source and are not hand-authored, so they are not
# committed.
*.g.dart
*.freezed.dart
*.gr.dart
*.mocks.dart
*.config.dart

# Local environment files. These carry machine- or developer-specific
# secrets/config (API keys, endpoints) and must never be committed.
.env
.env.*
*.env.local
